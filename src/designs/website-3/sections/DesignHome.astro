---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HoustonHero from './HoustonHero.astro';
import HoustonTrustBar from './HoustonTrustBar.astro';
import LeakClueGuide from './LeakClueGuide.astro';
import InspectionProcess from './InspectionProcess.astro';
import LeakDetectionServices from './LeakDetectionServices.astro';
import DetectionMethods from './DetectionMethods.astro';
import WhyChooseUs from './WhyChooseUs.astro';
import LeakDetectionPricing from './LeakDetectionPricing.astro';
import HoustonServiceAreas from './HoustonServiceAreas.astro';
import HoustonFaq from './HoustonFaq.astro';
import HoustonContact from './HoustonContact.astro';
import HoustonFooter from './HoustonFooter.astro';
const { title = 'Website 3' } = Astro.props;
---
<BaseLayout title={`${title} | Houston Leak Detection`} description="Learn about leak detection services for hidden slab, wall, ceiling, and water line leaks in Houston, Texas.">
  <main class="website-three" id="main-content">
    <HoustonHero />
    <HoustonTrustBar />
    <LeakClueGuide />
    <LeakDetectionServices />
    <InspectionProcess />
    <DetectionMethods />
    <WhyChooseUs />
    <LeakDetectionPricing />
    <HoustonServiceAreas />
    <HoustonContact />
    <HoustonFaq />
  </main>
  <HoustonFooter />
</BaseLayout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Manrope:wght@400;500;600;700;800&display=swap');
  main.website-three{font-family:'Manrope',ui-sans-serif,system-ui,sans-serif}
</style>
