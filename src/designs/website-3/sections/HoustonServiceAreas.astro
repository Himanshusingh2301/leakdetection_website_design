  </div>
</section>

<script>
  const houstonAreaScene = document.querySelector('.w3-area-scene');
  if (houstonAreaScene && 'IntersectionObserver' in window) {
    const areaSceneObserver = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        houstonAreaScene.classList.add('is-visible');
        areaSceneObserver.disconnect();
      }
    }, { threshold: 0.18 });
    areaSceneObserver.observe(houstonAreaScene);
  } else {
    houstonAreaScene?.classList.add('is-visible');
  }
</script>

