<section class="w3-pricing" id="pricing" aria-labelledby="w3-pricing-title">
  <div class="w3-pricing-inner">
    <header class="w3-pricing-heading">
      <p class="w3-pricing-kicker">PRICING <span aria-hidden="true">/</span> HOUSTON, TX</p>
      <h2 id="w3-pricing-title">Know the likely<br /><em>cost upfront.</em></h2>
      <p class="w3-pricing-intro">Typical Houston-area estimates for leak detection.</p>
    </header>

    <div class="w3-pricing-list" data-pricing-reveal aria-label="Typical leak detection price ranges">
      <div class="w3-pricing-row">
        <span class="w3-pricing-index" aria-hidden="true">01</span>
        <h3>Wall &amp; ceiling leaks</h3>
        <p class="w3-pricing-range"><span>$</span>250–600</p>
      </div>
      <div class="w3-pricing-row">
        <span class="w3-pricing-index" aria-hidden="true">02</span>
        <h3>Slab leak detection</h3>
        <p class="w3-pricing-range"><span>$</span>450–1,200</p>
      </div>
      <div class="w3-pricing-row">
        <span class="w3-pricing-index" aria-hidden="true">03</span>
        <h3>Underground water lines</h3>
        <p class="w3-pricing-range"><span>$</span>250–800</p>
      </div>
      <div class="w3-pricing-row">
        <span class="w3-pricing-index" aria-hidden="true">04</span>
        <h3>Commercial properties</h3>
        <p class="w3-pricing-range"><span>$</span>650<span>+</span></p>
      </div>
      <p class="w3-pricing-note">Typical local estimates; final price depends on the property and scope.</p>
    </div>
  </div>
</section>

<script>
  const pricingList = document.querySelector('[data-pricing-reveal]');
  if (pricingList && 'IntersectionObserver' in window) {
    const pricingObserver = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        pricingList.classList.add('is-visible');
        pricingObserver.disconnect();
      }
    }, { threshold: 0.2 });
    pricingObserver.observe(pricingList);
  } else {
    pricingList?.classList.add('is-visible');
  }
</script>

<style>
  .w3-pricing{position:relative;overflow:hidden;padding:clamp(62px,8vw,104px) clamp(22px,5vw,76px);background:#f7f0e7;color:#30241d}
