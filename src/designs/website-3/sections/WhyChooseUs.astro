<script>
  const whySection = document.querySelector('.w3-why');
  if (whySection && 'IntersectionObserver' in window) {
    const whyObserver = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        whySection.classList.add('is-visible');
        whyObserver.disconnect();
      }
