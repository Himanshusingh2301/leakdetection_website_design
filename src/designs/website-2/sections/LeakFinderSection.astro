<section class="w2-finder" id="symptoms" aria-labelledby="w2-finder-title">
  <div class="w2-shell">
    <div class="w2-finder-head">
      <div><p class="w2-kicker"><b>01</b> The first clues</p><h2 class="w2-heading" id="w2-finder-title">What’s happening <em>at your place?</em></h2><p class="w2-intro">Select a sign to see what it can mean and where an inspection may start.</p></div>
      <a class="w2-link" href="#faq">Not sure? Read common questions <span aria-hidden="true">↗</span></a>
    </div>
    <div class="w2-finder-grid">
      <div class="w2-symptom-list" role="tablist" aria-label="Choose a sign of a possible hidden leak">
        <button class="w2-symptom" id="w2-tab-bill" type="button" role="tab" aria-selected="true" aria-controls="w2-panel" data-title="A higher bill, with no clear reason." data-copy="A change in water use can come from a fixture, an appliance, or a hidden supply line. Comparing usage and checking the plumbing helps narrow it down." data-label="UNEXPLAINED WATER USE" data-photo="https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&fit=crop&w=1200&q=80" data-alt="Homeowner reviewing a household bill" tabindex="0"><span class="w2-symptom-icon" aria-hidden="true">↗</span><span><strong>Water bill went up</strong><small>Usage changed without an obvious reason</small></span><span class="w2-symptom-arrow" aria-hidden="true">→</span></button>
        <button class="w2-symptom" id="w2-tab-wall" type="button" role="tab" aria-selected="false" aria-controls="w2-panel" data-title="A mark on the wall may be a clue." data-copy="Bubbling paint, a damp patch, or a persistent musty smell can mean moisture is behind the surface. An inspection can check likely plumbing paths and help identify where the moisture may be coming from." data-label="WALL OR CEILING MOISTURE" data-photo="https://images.unsplash.com/photo-1620626011761-996317b8d101?auto=format&fit=crop&w=1200&q=80" data-alt="Interior wall and ceiling details in a home" tabindex="-1"><span class="w2-symptom-icon" aria-hidden="true">⌂</span><span><strong>Wall or ceiling stain</strong><small>Peeling paint, dampness, or a musty smell</small></span><span class="w2-symptom-arrow" aria-hidden="true">→</span></button>
        <button class="w2-symptom" id="w2-tab-floor" type="button" role="tab" aria-selected="false" aria-controls="w2-panel" data-title="Warm or wet flooring deserves a closer look." data-copy="A hot patch, unexplained dampness, or water sounds while fixtures are off can point toward a line under or near the floor. The next step is to check the pattern and test likely lines." data-label="FLOOR OR SLAB CLUE" data-photo="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1200&q=80" data-alt="Flooring inside a modern home" tabindex="-1"><span class="w2-symptom-icon" aria-hidden="true">⌁</span><span><strong>Warm or wet floor</strong><small>One area feels different from the rest</small></span><span class="w2-symptom-arrow" aria-hidden="true">→</span></button>
        <button class="w2-symptom" id="w2-tab-yard" type="button" role="tab" aria-selected="false" aria-controls="w2-panel" data-title="A soggy patch can follow a buried line." data-copy="Soil that stays wet or a strip of grass that stays green can be worth checking, especially when the weather has been dry. A focused inspection can help distinguish a plumbing leak from drainage or irrigation." data-label="OUTDOOR WATER CLUE" data-photo="https://images.unsplash.com/photo-1416879595882-3373a0480b5b?auto=format&fit=crop&w=1200&q=80" data-alt="Green yard and garden outside a home" tabindex="-1"><span class="w2-symptom-icon" aria-hidden="true">⌖</span><span><strong>Wet spot in the yard</strong><small>Ground stays damp when it hasn’t rained</small></span><span class="w2-symptom-arrow" aria-hidden="true">→</span></button>
        <button class="w2-symptom" id="w2-tab-pressure" type="button" role="tab" aria-selected="false" aria-controls="w2-panel" data-title="A pressure change can have several causes." data-copy="Low pressure at one fixture may point to a local issue; a change throughout the home can involve a wider section of plumbing. Note where you notice it and when it began." data-label="LOW WATER PRESSURE" data-photo="https://images.unsplash.com/photo-1600566753190-17f0baa2a6c3?auto=format&fit=crop&w=1200&q=80" data-alt="Modern bathroom fixtures in a home" tabindex="-1"><span class="w2-symptom-icon" aria-hidden="true">↘</span><span><strong>Pressure feels lower</strong><small>At one fixture or throughout the home</small></span><span class="w2-symptom-arrow" aria-hidden="true">→</span></button>
        <button class="w2-symptom" id="w2-tab-sound" type="button" role="tab" aria-selected="false" aria-controls="w2-panel" data-title="Water sounds when everything is off?" data-copy="A faint hiss, trickle, or running-water sound can be a clue. Check that fixtures and appliances are off, then note where the sound is easiest to hear." data-label="UNEXPECTED WATER SOUND" data-photo="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1200&q=80" data-alt="Quiet interior of a home with a hallway and living space" tabindex="-1"><span class="w2-symptom-icon" aria-hidden="true">)))</span><span><strong>Hear water running</strong><small>Even when fixtures are turned off</small></span><span class="w2-symptom-arrow" aria-hidden="true">→</span></button>
      </div>
      <div class="w2-symptom-result" id="w2-panel" role="tabpanel" aria-labelledby="w2-tab-bill">
        <img id="w2-symptom-image" src="https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&fit=crop&w=1200&q=80" alt="Homeowner reviewing a household bill" loading="lazy" />
        <span class="w2-result-count" id="w2-result-label">UNEXPLAINED WATER USE</span>
        <div class="w2-result-text"><small>One clue, several possibilities</small><h3 id="w2-result-title">A higher bill, with no clear reason.</h3><p id="w2-result-copy">A change in water use can come from a fixture, an appliance, or a hidden supply line. Comparing usage and checking the plumbing helps narrow it down.</p><a class="w2-result-action" href="#process">See how an inspection works <span aria-hidden="true">↗</span></a></div>
      </div>
    </div>
    <p class="w2-finder-disclaimer">These signs can have more than one cause. An on-site inspection is needed to confirm a leak.</p>
  </div>
</section>
<script>
  const finderTabs = [...document.querySelectorAll<HTMLButtonElement>('.w2-symptom')];
  const resultPanel = document.querySelector<HTMLElement>('#w2-panel');
  const resultImage = document.querySelector<HTMLImageElement>('#w2-symptom-image');
  const resultTitle = document.querySelector<HTMLElement>('#w2-result-title');
  const resultCopy = document.querySelector<HTMLElement>('#w2-result-copy');
  const resultLabel = document.querySelector<HTMLElement>('#w2-result-label');
  function selectSymptom(tab: HTMLButtonElement, focus = false) {
    finderTabs.forEach((item) => { const active = item === tab; item.setAttribute('aria-selected', String(active)); item.tabIndex = active ? 0 : -1; });
    resultPanel?.setAttribute('aria-labelledby', tab.id);
    if (resultTitle) resultTitle.textContent = tab.dataset.title ?? '';
    if (resultCopy) resultCopy.textContent = tab.dataset.copy ?? '';
    if (resultLabel) resultLabel.textContent = tab.dataset.label ?? '';
    if (resultImage && tab.dataset.photo) { resultImage.src = tab.dataset.photo; resultImage.alt = tab.dataset.alt ?? ''; }
    if (focus) tab.focus();
  }
  finderTabs.forEach((tab, index) => {
    tab.addEventListener('click', () => selectSymptom(tab));
    tab.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowDown' && event.key !== 'ArrowRight' && event.key !== 'ArrowUp' && event.key !== 'ArrowLeft') return;
      event.preventDefault();
      const delta = event.key === 'ArrowDown' || event.key === 'ArrowRight' ? 1 : -1;
      selectSymptom(finderTabs[(index + delta + finderTabs.length) % finderTabs.length], true);
    });
  });
</script>
