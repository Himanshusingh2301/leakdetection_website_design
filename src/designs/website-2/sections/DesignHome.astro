---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import './website-2.css';
import HoustonHeader from './HoustonHeader.astro';
import HoustonHero from './HoustonHero.astro';
import HoustonProofBar from './HoustonProofBar.astro';
import LeakFinderSection from './LeakFinderSection.astro';
import HoustonProcessSection from './HoustonProcessSection.astro';
import HoustonServiceAreaSection from './HoustonServiceAreaSection.astro';
import HoustonFaqSection from './HoustonFaqSection.astro';
import HoustonFinalCta from './HoustonFinalCta.astro';
import HoustonFooter from './HoustonFooter.astro';
import HoustonServicesSection from './HoustonServicesSection.astro';
import HoustonThermalSection from './HoustonThermalSection.astro';
import HoustonPricingSection from './HoustonPricingSection.astro';
import HoustonPromiseSection from './HoustonPromiseSection.astro';
import HoustonCaseStudySection from './HoustonCaseStudySection.astro';
import HoustonReviewsSection from './HoustonReviewsSection.astro';

const title = 'Leak Detection in Houston, TX | Gulfline Leak Detection';
const description = 'Learn how professional leak detection can help locate hidden water leaks in Houston homes and businesses, what signs to watch for, and what to expect during an inspection.';
---

<BaseLayout title={title} description={description}>
  <div class="w2-site">
    <a class="w2-skip" href="#main-content">Skip to content</a>
    <HoustonHeader />
    <main id="main-content">
      <HoustonHero />
      <HoustonProofBar />
      <LeakFinderSection />
      <HoustonServicesSection />
      <HoustonThermalSection />
      <HoustonProcessSection />
      <HoustonPricingSection />
      <HoustonServiceAreaSection />
      <HoustonCaseStudySection />
      <HoustonPromiseSection />
      <HoustonReviewsSection />
      <HoustonFaqSection />
      <HoustonFinalCta />
    </main>
    <HoustonFooter />
  </div>
</BaseLayout>
