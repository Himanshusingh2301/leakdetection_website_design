<section class="w2-process" id="process" aria-labelledby="w2-process-title">
  <div class="w2-shell">
    <header class="w2-process-head">
      <div>
        <p class="w2-kicker"><b>07</b> A clearer way to find a leak</p>
        <h2 class="w2-heading" id="w2-process-title">A leak detection visit, <em>step by step.</em></h2>
      </div>
      <p class="w2-intro">Know what to expect, from the first clue you share to a clear explanation of what the inspection found.</p>
    </header>

    <div class="w2-process-experience">
      <nav class="w2-process-nav" role="tablist" aria-label="Steps in a leak detection visit">
        <button class="w2-process-tab is-active" id="w2-process-tab-1" type="button" role="tab" aria-selected="true" aria-controls="w2-process-panel" tabindex="0" data-process-step="1" data-process-label="LISTEN" data-process-title="Tell us what you’ve noticed." data-process-copy="Share the signs, where they appear, and when they started. A higher bill, a damp patch, or an unexpected water sound can help focus the inspection." data-process-note="Your observations give the inspection a useful starting point.">
          <span class="w2-process-tab-num">01</span><span class="w2-process-tab-text"><small>FIRST</small><strong>Share the clue</strong></span><span class="w2-process-tab-arrow" aria-hidden="true">↗</span>
        </button>
        <button class="w2-process-tab" id="w2-process-tab-2" type="button" role="tab" aria-selected="false" aria-controls="w2-process-panel" tabindex="-1" data-process-step="2" data-process-label="INSPECT" data-process-title="Check the likely plumbing paths." data-process-copy="The technician looks at the affected areas, nearby fixtures, pipe routes, and access. The inspection approach is guided by the symptoms and the property." data-process-note="The right checks depend on the line, the location, and what is accessible.">
          <span class="w2-process-tab-num">02</span><span class="w2-process-tab-text"><small>THEN</small><strong>Inspect the area</strong></span><span class="w2-process-tab-arrow" aria-hidden="true">↗</span>
        </button>
        <button class="w2-process-tab" id="w2-process-tab-3" type="button" role="tab" aria-selected="false" aria-controls="w2-process-panel" tabindex="-1" data-process-step="3" data-process-label="LOCATE" data-process-title="Narrow down the source." data-process-copy="Appropriate detection checks help trace the signs toward the area most likely connected to the leak. The technician explains what the evidence can and cannot confirm." data-process-note="The visit is focused on locating and documenting a suspected leak.">
          <span class="w2-process-tab-num">03</span><span class="w2-process-tab-text"><small>FOCUS</small><strong>Locate the leak</strong></span><span class="w2-process-tab-arrow" aria-hidden="true">↗</span>
        </button>
        <button class="w2-process-tab" id="w2-process-tab-4" type="button" role="tab" aria-selected="false" aria-controls="w2-process-panel" tabindex="-1" data-process-step="4" data-process-label="EXPLAIN" data-process-title="Leave with clear findings." data-process-copy="Review what was checked, the likely leak location, and any limits of the inspection. You’ll have clear information to guide your next decision." data-process-note="This service provides leak detection and findings; it does not perform repairs.">
          <span class="w2-process-tab-num">04</span><span class="w2-process-tab-text"><small>FINALLY</small><strong>Review findings</strong></span><span class="w2-process-tab-arrow" aria-hidden="true">↗</span>
        </button>
      </nav>

      <article class="w2-process-panel" id="w2-process-panel" role="tabpanel" aria-labelledby="w2-process-tab-1" tabindex="0">
        <div class="w2-process-visual" aria-hidden="true">
          <div class="w2-process-visual-top"><span><i></i> FIELD NOTES</span><span class="w2-process-visual-live">INSPECTION <b>01 / 04</b></span></div>
          <div class="w2-process-visual-body">
            <div class="w2-process-pipe-map">
              <svg viewBox="0 0 420 210" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path class="w2-map-pipe" d="M24 105H105V52H202V105H291V157H396" />
                <path class="w2-map-branch" d="M105 52V24M202 105V184M291 157V187" />
                <circle class="w2-map-node" cx="202" cy="105" r="9" />
                <circle class="w2-map-ripple w2-map-ripple-a" cx="202" cy="105" r="25" />
                <circle class="w2-map-ripple w2-map-ripple-b" cx="202" cy="105" r="25" />
                <circle class="w2-map-point" cx="24" cy="105" r="5" />
                <circle class="w2-map-point" cx="396" cy="157" r="5" />
              </svg>
              <span class="w2-map-label w2-map-label-a">WATER LINE</span><span class="w2-map-label w2-map-label-b">CHECK AREA</span>
            </div>
            <div class="w2-process-signal"><span class="w2-process-signal-label">OBSERVATION</span><svg viewBox="0 0 290 48" preserveAspectRatio="none"><path d="M0 24H82L91 19L100 29L110 22L121 24H148L157 8L165 41L174 14L182 31L191 22L200 24H290" /></svg><span class="w2-process-signal-key"><i></i> clue to investigate</span></div>
          </div>
          <div class="w2-process-visual-bottom"><span>OBSERVE</span><b></b><span>CHECK</span><b></b><span>EXPLAIN</span></div>
          <span class="w2-process-visual-stamp">LEAK<br />DETECTION<br /><strong>ONLY</strong></span>
        </div>
        <div class="w2-process-panel-copy">
          <p class="w2-process-panel-step"><span id="w2-process-active-number">01</span><span id="w2-process-active-label">LISTEN</span></p>
          <h3 id="w2-process-active-title">Tell us what you’ve noticed.</h3>
          <p class="w2-process-panel-description" id="w2-process-active-copy">Share the signs, where they appear, and when they started. A higher bill, a damp patch, or an unexpected water sound can help focus the inspection.</p>
          <div class="w2-process-panel-note"><span aria-hidden="true">✳</span><p id="w2-process-active-note">Your observations give the inspection a useful starting point.</p></div>
          <div class="w2-process-panel-controls"><span>SELECT A STEP TO EXPLORE</span><div><button class="w2-process-prev" type="button" aria-label="Previous step" disabled>←</button><button class="w2-process-next" type="button" aria-label="Next step">Next step <span aria-hidden="true">→</span></button></div></div>
        </div>
      </article>
    </div>
    <p class="w2-process-footnote"><span aria-hidden="true">i</span> Every property is different. Inspection methods and timing depend on the pipe layout, access, and signs present.</p>
  </div>
</section>

<script>
  const processTabs = [...document.querySelectorAll<HTMLButtonElement>('.w2-process-tab')];
  const processPanel = document.querySelector<HTMLElement>('#w2-process-panel');
  const processNumber = document.querySelector<HTMLElement>('#w2-process-active-number');
  const processLabel = document.querySelector<HTMLElement>('#w2-process-active-label');
  const processTitle = document.querySelector<HTMLElement>('#w2-process-active-title');
  const processCopy = document.querySelector<HTMLElement>('#w2-process-active-copy');
  const processNote = document.querySelector<HTMLElement>('#w2-process-active-note');
  const processVisualCount = document.querySelector<HTMLElement>('.w2-process-visual-live b');
  const processPrev = document.querySelector<HTMLButtonElement>('.w2-process-prev');
  const processNext = document.querySelector<HTMLButtonElement>('.w2-process-next');

  function selectProcessStep(index: number, focus = false) {
    const boundedIndex = Math.max(0, Math.min(processTabs.length - 1, index));
    const tab = processTabs[boundedIndex];
    if (!tab) return;
    processTabs.forEach((item, itemIndex) => {
      const active = itemIndex === boundedIndex;
      item.classList.toggle('is-active', active);
      item.setAttribute('aria-selected', String(active));
      item.tabIndex = active ? 0 : -1;
    });
    processPanel?.setAttribute('aria-labelledby', tab.id);
    if (processNumber) processNumber.textContent = String(boundedIndex + 1).padStart(2, '0');
    if (processLabel) processLabel.textContent = tab.dataset.processLabel ?? '';
    if (processTitle) processTitle.textContent = tab.dataset.processTitle ?? '';
    if (processCopy) processCopy.textContent = tab.dataset.processCopy ?? '';
    if (processNote) processNote.textContent = tab.dataset.processNote ?? '';
    if (processVisualCount) processVisualCount.textContent = `${String(boundedIndex + 1).padStart(2, '0')} / 04`;
    if (processPrev) processPrev.disabled = boundedIndex === 0;
    if (processNext) processNext.disabled = false;
    if (processNext) processNext.innerHTML = boundedIndex === processTabs.length - 1 ? 'Start again <span aria-hidden="true">↺</span>' : 'Next step <span aria-hidden="true">→</span>';
    if (focus) tab.focus();
  }

  processTabs.forEach((tab, index) => {
    tab.addEventListener('click', () => selectProcessStep(index));
    tab.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft' && event.key !== 'Home' && event.key !== 'End') return;
      event.preventDefault();
      const nextIndex = event.key === 'Home' ? 0 : event.key === 'End' ? processTabs.length - 1 : index + (event.key === 'ArrowRight' ? 1 : -1 + processTabs.length);
      selectProcessStep((nextIndex + processTabs.length) % processTabs.length, true);
    });
  });
  processPrev?.addEventListener('click', () => selectProcessStep(Math.max(0, processTabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true') - 1)));
  processNext?.addEventListener('click', () => {
    const currentIndex = processTabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true');
    selectProcessStep(currentIndex === processTabs.length - 1 ? 0 : currentIndex + 1);
  });
</script>
