<script>
  const serviceOptions = document.querySelectorAll<HTMLButtonElement>('.w2-service-option');
  const servicePanels = document.querySelectorAll<HTMLElement>('.w2-service-panel');

  serviceOptions.forEach((option) => {
    option.addEventListener('click', () => {
      const selectedService = option.dataset.serviceSelect;
      serviceOptions.forEach((item) => {
        const isActive = item === option;
        item.classList.toggle('is-active', isActive);
        item.setAttribute('aria-pressed', String(isActive));
      });
      servicePanels.forEach((panel) => {
        panel.hidden = panel.dataset.servicePanel !== selectedService;
      });
    });
  });
</script>



