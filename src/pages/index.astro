---
import BaseLayout from '../layouts/BaseLayout.astro';

const designs = [
  { number: '01', name: 'Website 1', href: '/website-1/', description: 'A dedicated home for the first website design.' },
  { number: '02', name: 'Website 2', href: '/website-2/', description: 'A dedicated home for the second website design.' },
  { number: '03', name: 'Website 3', href: '/website-3/', description: 'A dedicated home for the third website design.' },
];
---

<BaseLayout
  title="Website Design Library | Three Astro Website Concepts"
  description="Explore three independent website design concepts built with Astro. Choose a design to preview its pages and reusable sections."
>
  <main class="home-shell">
    <div class="topline"><a class="wordmark" href="/">DESIGN<span>INDEX</span></a><span class="edition">ASTRO DESIGN LIBRARY · 2026</span></div>
    <section class="intro" aria-labelledby="page-title">
      <p class="eyebrow"><span></span> A growing collection of web concepts</p>
      <h1 id="page-title">Three directions.<br /><em>One starting point.</em></h1>
      <p class="lead">Choose a website concept to explore. Each design has its own pages, styles, and reusable sections, ready to grow independently.</p>
    </section>
    <nav class="design-list" aria-label="Website design concepts">
      {designs.map((design) => (
        <a class="design-card" href={design.href} aria-label={`Explore ${design.name}`}>
          <span class="card-number">{design.number}</span>
          <span class="card-copy"><strong>{design.name}</strong><small>{design.description}</small></span>
          <span class="card-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </nav>
    <footer><span>BUILT TO EXPAND</span><span>More concepts can be added as the collection grows <b>↗</b></span></footer>
  </main>
</BaseLayout>

<style>
  .home-shell { max-width: 1100px; min-height: 100vh; margin: 0 auto; padding: 34px 7.2% 24px; display: flex; flex-direction: column; }
  .topline, footer { display: flex; justify-content: space-between; align-items: center; }
  .wordmark { text-decoration: none; font-size: .77rem; font-weight: 850; letter-spacing: .12em; }
  .wordmark span { color: #809188; font-weight: 500; }
  .edition, footer { color: #7c8982; font-size: .62rem; letter-spacing: .1em; }
  .intro { margin: clamp(74px, 12vh, 128px) 0 52px; max-width: 650px; }
  .eyebrow { display: flex; align-items: center; gap: 10px; color: #63766b; text-transform: uppercase; letter-spacing: .13em; font-size: .67rem; font-weight: 700; }
  .eyebrow span { width: 7px; height: 7px; border-radius: 50%; background: #7ca58b; }
  h1 { margin: 20px 0; font-size: clamp(3.2rem, 7.3vw, 6rem); letter-spacing: -.075em; line-height: .98; font-weight: 650; }
  h1 em { color: #82958a; font-weight: 450; }
  .lead { max-width: 440px; color: #69766f; font-size: 1rem; line-height: 1.75; }
  .design-list { border-top: 1px solid #dce2dc; }
  .design-card { display: grid; grid-template-columns: 58px 1fr 40px; align-items: center; gap: 16px; min-height: 100px; padding: 18px 10px; border-bottom: 1px solid #dce2dc; text-decoration: none; transition: padding .2s ease, background .2s ease; }
  .design-card:hover { padding-left: 18px; padding-right: 18px; background: #edf1ec; }
  .card-number { color: #82958a; font-size: .75rem; }
  .card-copy { display: grid; gap: 6px; }
  .card-copy strong { font-size: 1.22rem; font-weight: 600; letter-spacing: -.03em; }
  .card-copy small { color: #77837c; font-size: .83rem; }
  .card-arrow { justify-self: end; color: #6f8979; font-size: 1.25rem; }
  footer { margin-top: auto; padding-top: 56px; font-size: .6rem; }
  footer b { margin-left: 8px; font-size: .9rem; color: #5c7766; }
  @media (max-width: 560px) { .home-shell { padding: 24px 6% 20px; } .edition { font-size: .52rem; } .intro { margin: 80px 0 38px; } .design-card { grid-template-columns: 34px 1fr 24px; gap: 10px; } .card-copy small { max-width: 230px; line-height: 1.5; } footer { gap: 18px; align-items: flex-start; } }
</style>
